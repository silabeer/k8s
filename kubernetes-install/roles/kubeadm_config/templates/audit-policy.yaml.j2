{# {{ ansible_managed }} #}
{#
  Минимальный вариант из раздела 14.1 playbook. Финальная политика
  согласуется с ИБ. Логи отгружаются observability-агентом (wave 0)
  в центральное хранилище.

  Правила применяются сверху вниз, первое совпавшее выигрывает — поэтому
  шумные исключения идут первыми, а универсальное `level: Metadata`
  замыкает список.
-#}
apiVersion: audit.k8s.io/v1
kind: Policy
omitStages:
  - RequestReceived

rules:
  # --- Шум, который иначе съест весь объём хранилища ---
  - level: None
    users: ["system:kube-proxy"]
    verbs: ["watch"]

  - level: None
    userGroups: ["system:nodes"]
    verbs: ["get"]
    resources:
      - group: ""
        resources: ["nodes", "nodes/status"]

  - level: None
    users: ["system:apiserver"]
    verbs: ["get"]
    resources:
      - group: ""
        resources: ["namespaces", "namespaces/status", "namespaces/finalize"]

  - level: None
    nonResourceURLs:
      - /healthz*
      - /livez*
      - /readyz*
      - /version
      - /metrics

  # --- Доступ к секретам: только метаданные, тело никогда не пишем ---
  - level: Metadata
    resources:
      - group: ""
        resources: ["secrets", "configmaps"]
      - group: "authentication.k8s.io"
        resources: ["tokenreviews"]

  # --- Изменения: полное тело запроса и ответа ---
  - level: RequestResponse
    verbs: ["create", "update", "patch", "delete", "deletecollection"]
    resources:
      - group: ""
      - group: "apps"
      - group: "batch"
      - group: "rbac.authorization.k8s.io"
      - group: "networking.k8s.io"
      - group: "policy"
      - group: "admissionregistration.k8s.io"
      - group: "apiextensions.k8s.io"
      - group: "certificates.k8s.io"

  # --- Всё остальное ---
  - level: Metadata
