---
# Шаблон. Реальный файл secrets.yml создаётся CI из переменных окружения и
# в репозиторий не коммитится (см. .gitignore).
#
# Ключ должен иметь доступ на чтение к ТЕСТОВОМУ GitOps-репозиторию,
# отдельному от production (раздел 25.5).
#
#   printf '%s\n' "$MOLECULE_GITOPS_DEPLOY_KEY" > secrets_key
#   ansible-vault ... либо простой YAML, как здесь:
gitops-deploy-key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  <содержимое тестового deploy key>
  -----END OPENSSH PRIVATE KEY-----
