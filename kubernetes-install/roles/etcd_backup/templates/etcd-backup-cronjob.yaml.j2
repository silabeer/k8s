{# {{ ansible_managed }} #}
# РЕФЕРЕНСНЫЙ манифест. Ansible его НЕ применяет — скопируйте в
# infrastructure/etcd-backup/ GitOps-репозитория (wave 0, раздел 28.1).
#
# Ключевые детали, которые легко упустить:
#   * hostNetwork: true — без него Pod не достучится до 127.0.0.1:2379;
#   * tolerations на taint control-plane — иначе Pod никуда не запланируется;
#   * nodeSelector на control-plane — сертификаты etcd есть только там;
#   * hostPath к /etc/kubernetes/pki/etcd — только чтение;
#   * ОБОЛОЧКИ В ОБРАЗЕ etcd НЕТ. Он distroless: `/bin/sh -c` даёт
#     «OCI runtime create failed», контейнер не стартует вовсе, и в логах
#     задания при этом ПУСТО. Поэтому команда вызывает etcdctl напрямую, а
#     имя файла снимка формируется без shell — подстановкой при рендере.
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: etcd-backup
  namespace: kube-system
  annotations:
    argocd.argoproj.io/sync-wave: "0"
spec:
  schedule: "0 2 * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 2
      template:
        spec:
          restartPolicy: OnFailure
          # Pod обращается к etcd по 127.0.0.1:2379 — без hostNetwork
          # этот адрес указывает внутрь сетевого namespace Pod'а.
          hostNetwork: true
          nodeSelector:
            node-role.kubernetes.io/control-plane: ""
          tolerations:
            - key: node-role.kubernetes.io/control-plane
              operator: Exists
              effect: NoSchedule
          securityContext:
            runAsUser: 0
          containers:
            - name: etcd-backup
              image: {{ etcd_backup_cronjob_image }}
              # etcdctl напрямую, без /bin/sh: оболочки в образе нет.
              # Имя файла со временем не вычислить внутри контейнера, поэтому
              # снимок пишется под постоянным именем, а отметку времени
              # добавляет ротация на стороне хранилища либо отдельный шаг.
              command:
                - etcdctl
                - --endpoints=https://127.0.0.1:2379
                - --cacert=/etc/kubernetes/pki/etcd/ca.crt
                - --cert=/etc/kubernetes/pki/etcd/server.crt
                - --key=/etc/kubernetes/pki/etcd/server.key
                - snapshot
                - save
                - /backup/etcd-snapshot-latest.db
              volumeMounts:
                - name: etcd-certs
                  mountPath: /etc/kubernetes/pki/etcd
                  readOnly: true
                - name: backup
                  mountPath: /backup
          volumes:
            - name: etcd-certs
              hostPath:
                path: /etc/kubernetes/pki/etcd
                type: Directory
            - name: backup
              hostPath:
                path: {{ etcd_backup_dir }}
                type: DirectoryOrCreate
