{# {{ ansible_managed }} #}
{#
  Конфигурация SPIRE server. Формат HCL.

  Заметки, важные при правках:
    * trust_domain входит в каждый SPIFFE ID и в сертификаты — смена
      равнозначна переизданию всех идентичностей;
    * ca_ttl должен быть заметно больше default_x509_svid_ttl, иначе
      сертификаты рабочих нагрузок начнут переживать собственный CA;
    * k8s_psat проверяет токен обращением к apiserver того кластера,
      поэтому серверу нужен kubeconfig КАЖДОГО кластера.
-#}
server {
    bind_address = "{{ spire_bind_address }}"
    bind_port    = "{{ spire_bind_port }}"
    trust_domain = "{{ spire_trust_domain }}"
    data_dir     = "{{ spire_data_dir }}"
    socket_path  = "{{ spire_socket_path }}"
    log_level    = "INFO"
{#
  log_file НЕ задаётся: журнал идёт в stdout, а его подхватывает journald —
  туда же, где логи всех остальных служб узла.

  Файл был первой попыткой и не заработал: под ProtectSystem=strict запись
  в /var/log отвергается, даже когда права на каталоге верные и та же
  запись от имени того же пользователя из оболочки проходит. Обходить это
  через ReadWritePaths можно, но незачем: отдельный файл на systemd-хосте
  только раздваивает место, куда смотреть при разборе.
-#}

    ca_ttl                = "{{ spire_ca_ttl }}"
    default_x509_svid_ttl = "{{ spire_default_x509_svid_ttl }}"
    default_jwt_svid_ttl  = "{{ spire_default_jwt_svid_ttl }}"

    ca_subject {
        country      = ["{{ spire_ca_subject.country }}"]
        organization = ["{{ spire_ca_subject.organization }}"]
        common_name  = "{{ spire_ca_subject.common_name }}"
    }
}

plugins {
    DataStore "{{ spire_datastore_plugin }}" {
        plugin_data {
            database_type     = "{{ spire_datastore_type }}"
            connection_string = "{{ spire_datastore_connection_string }}"
        }
    }

{% if spire_upstream_authority == 'vault' %}
{#
  UpstreamAuthority подчиняет CA сервера SPIRE внешнему PKI: сервер
  перестаёт быть корнем и получает ПРОМЕЖУТОЧНЫЙ сертификат, а выданные им
  SVID проверяются цепочкой до корпоративного корня (ADR 0003).

  Плагин написан под HashiCorp Vault. OpenBao совместим по API, и это
  ровно то допущение, ради проверки которого схема разворачивалась.

  ca_cert_path обязателен, когда сам PKI работает под собственным центром
  сертификации: без него плагин не доверяет серверу, и отказ выглядит как
  ошибка соединения, а не как отсутствие доверия.
-#}
    UpstreamAuthority "vault" {
        plugin_data {
            vault_addr      = "{{ spire_vault_addr }}"
            pki_mount_point = "{{ spire_vault_pki_mount }}"
            ca_cert_path    = "{{ spire_vault_ca_cert_path }}"

            token_auth {
                token = "{{ spire_vault_token }}"
            }
        }
    }
{% endif %}
{% if spire_node_attestor_join_token %}
{#
  join_token нужен там, где кластеров ещё нет: аттестация агента
  одноразовым токеном. Для production не годится — токен выдаёт человек, —
  но проверить механизм выдачи SVID им дешевле, чем поднимать кластер.
-#}
    NodeAttestor "join_token" {
        plugin_data {}
    }
{% endif %}
{% for cluster in spire_clusters %}
    NodeAttestor "k8s_psat" {
        plugin_data {
            clusters = {
                "{{ cluster.name }}" = {
                    service_account_allow_list = {{ cluster.service_account_allow_list | to_json }}
                    kube_config_file           = "{{ spire_config_dir }}/kubeconfig/{{ cluster.name }}.kubeconfig"
                }
            }
        }
    }
{% endfor %}

    KeyManager "disk" {
        plugin_data {
            keys_path = "{{ spire_data_dir }}/keys.json"
        }
    }
}

health_checks {
    listener_enabled = true
    bind_address     = "127.0.0.1"
    bind_port        = "8080"
    live_path        = "/live"
    ready_path       = "/ready"
}
