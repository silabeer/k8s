collections/
.ansible_facts/
*.retry
artifacts/

# Molecule
molecule-shared/resources/.vagrant/
**/molecule/**/.molecule/

# Секреты. Файлы secrets.yml в сценариях kubeadm_config и haproxy_keepalived
# содержат заведомо тестовые значения и коммитятся намеренно; сценариям
# bootstrap-ролей нужен настоящий deploy key, который создаёт CI.
roles/cilium_bootstrap/molecule/default/secrets.yml
roles/argocd_bootstrap/molecule/default/secrets.yml
**/vault-pass*
**/*.vault.yml.decrypted
inventories/*/secrets.vault.yml

# Локальный inventory с фактическими адресами стенда: репозиторий публичный,
# связка «адреса + конфигурация кластера» наружу не идёт.
inventories/*/hosts.local.yml
inventories/*/group_vars/all/99-local.yml
