---
profile: production

exclude_paths:
  # Файлы upstream, скопированные без изменений: править их нельзя,
  # иначе теряется смысл фиксации версии.
  - roles/artifact_keeper/files/
  - collections/
  - .ansible_facts/
  # Файлы секретов и справочные YAML — не playbook, линтер пытается разобрать
  # их как список plays и падает.

skip_list:
  # kubeadm/helm/cilium не имеют идемпотентных модулей; вызовы command обёрнуты
  # собственными pre-check (раздел 24 playbook), changed_when задан явно.
  - command-instead-of-shell

# ВАЖНО: линтеры запускаются в версиях, закреплённых в requirements-test.txt.
# На ansible-lint 6.x (например, из системного pip) проект даёт ложные ошибки:
#   * schema[meta] на platform `noble` — Ubuntu 24.04 новее схемы, вшитой в 6.x;
#   * jinja[invalid] в roles/preflight — нет netaddr, зависимости фильтра ipaddr.
# Ставьте окружение через `make deps`.

warn_list:
  - experimental

# Переменные ролей проверяются на префикс имени роли
var_naming_pattern: "^[a-z_][a-z0-9_]*$"
